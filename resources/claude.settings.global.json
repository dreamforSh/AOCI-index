{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/aoci-index/scripts/aoci_hook.py --host claude-code --event session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/aoci-index/scripts/aoci_hook.py --host claude-code --event turn-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/aoci-index/scripts/aoci_hook.py --host claude-code --event stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
