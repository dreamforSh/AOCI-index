        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),'.claude/skills/aoci-index/scripts/aoci_hook.py'),run_name='__main__')\" --host claude-code --event stop",
